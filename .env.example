# --------------------------------------------------------------------------
# Billi — root env reference. Copy the relevant blocks into the app-specific
# files listed below. Never commit real secrets.
# --------------------------------------------------------------------------
#
# Split target:
#   apps/web/.env.local      → Vite build-time vars (must be prefixed VITE_*)
#   apps/api/.dev.vars       → Worker dev-time vars (used by wrangler dev)
#   Wrangler secrets (prod)  → `wrangler secret put <NAME>` for production
#
# --------------------------------------------------------------------------

# ───── Frontend (apps/web/.env.local) ─────
# Clerk publishable key — embedded in the JS bundle. NOT a secret.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Optional: override the API base URL if you're not using the Vite /api proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8787

# ───── API Worker (apps/api/.dev.vars and `wrangler secret put` in prod) ─────
# Clerk server-side secret. Never ship to frontend.
CLERK_SECRET_KEY=sk_test_replace_me
# Turso (libSQL) connection. For local dev a file:./local.db works too.
TURSO_DATABASE_URL=libsql://billi-dev-<you>.turso.io
TURSO_AUTH_TOKEN=replace_me
# OpenRouter — used by BIL-13 embedding pipeline. Not required for auth/ledger slices.
OPENROUTER_API_KEY=replace_me
