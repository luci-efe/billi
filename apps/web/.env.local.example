# Copy to apps/web/.env.local (git-ignored) and fill in the real values.
# Restart `bun dev:web` after any change.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Override the API base URL when not using the Vite /api proxy.
# In CI (staging), this is set via the STAGING_API_BASE_URL GitHub Actions variable.
# Locally, leave blank to use the proxy, or point at a running Worker:
VITE_API_BASE_URL=
# VITE_API_BASE_URL=http://127.0.0.1:8787
